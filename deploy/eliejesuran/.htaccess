# IsraPoll — réglages du dossier /israpoll/ (Apache, hébergement Infomaniak).
# Si le dossier répond « 500 » après un déploiement, supprimer ce fichier : le site fonctionne sans (seul le cache change).
<IfModule mod_headers.c>
  # Pages, styles et scripts : toujours revalider auprès du serveur (déploiements fréquents le soir du scrutin)
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript
</IfModule>
AddDefaultCharset UTF-8
